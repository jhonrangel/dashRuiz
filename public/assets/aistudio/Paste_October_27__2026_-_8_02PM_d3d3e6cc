                    <h3 id="kpi-volumen" class="text-3xl font-extrabold text-white mt-1">0</h3>
                </div>
                <div class="p-2.5 bg-blue-500/10 text-blue-400 rounded-xl"><i data-lucide="boxes" class="w-6 h-6"></i></div>
            </div>
            <div class="mt-3 flex items-center text-xs text-slate-400"><span id="kpi-volumen-lm" class="text-blue-400 font-semibold mr-1">0</span> Produc Total LM</div>
        </div>

        <div class="glass-card p-5 rounded-2xl border-l-4 border-indigo-500 relative overflow-hidden">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Horas Ejecutadas</p>
                    <h3 id="kpi-horas" class="text-3xl font-extrabold text-white mt-1">0</h3>
                </div>
                <div class="p-2.5 bg-indigo-500/10 text-indigo-400 rounded-xl"><i data-lucide="clock" class="w-6 h-6"></i></div>
