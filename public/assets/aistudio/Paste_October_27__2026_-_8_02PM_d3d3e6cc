        let currentFilter = 'ALL';
        let barChart, lineChart, doughnutVol, doughnutHrs;

        function initDashboard() {
            renderTabs();
            updateKPIs(rawData);
            renderCharts(rawData);
            renderTable(rawData);
            setupSearch();
            lucide.createIcons();
        }

        function renderTabs() {
            const processes = ['ALL', ...new Set(rawData.map(item => item.proceso))];
            const container = document.getElementById('process-tabs');
            container.innerHTML = processes.map(proc => `
                <button onclick="filterProcess('${proc}')" class="process-tab px-5 py-2.5 rounded-xl font-medium text-sm transition-all ${currentFilter === proc ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/30' : 'bg-slate-900 text-slate-400 hover:text-white hover:bg-slate-800'} whitespace-nowrap">
                    ${proc === 'ALL' ? 'Todos los Procesos' : proc}
                </button>
            `).join('');
        }

        function filterProcess(proc) {
            currentFilter = proc;
            renderTabs();
            const filteredData = proc === 'ALL' ? rawData : rawData.filter(item => item.proceso === proc);
            updateKPIs(filteredData);
            updateCharts(filteredData);
            renderTable(filteredData);
        }

        function updateKPIs(data) {
            const totalVol = data.reduce((acc, curr) => acc + curr.vol, 0);
            const totalVolLm = data.reduce((acc, curr) => acc + curr.prodLm, 0);
            const totalHoras = data.reduce((acc, curr) => acc + curr.horas, 0);
            const totalDif = data.reduce((acc, curr) => acc + curr.dif, 0);
            const avgOee = data.length > 0 ? (data.reduce((acc, curr) => acc + curr.oee, 0) / data.length) * 100 : 0;
            const avgCal = data.length > 0 ? (data.reduce((acc, curr) => acc + curr.pCal, 0) / data.length) * 100 : 0;

            document.getElementById('kpi-volumen').innerText = totalVol.toLocaleString();
            document.getElementById('kpi-volumen-lm').innerText = totalVolLm.toLocaleString();
            document.getElementById('kpi-horas').innerText = totalHoras.toLocaleString();
            document.getElementById('kpi-dif-horas').innerText = totalDif.toLocaleString();
            document.getElementById('kpi-oee').innerText = avgOee.toFixed(1) + '%';
            document.getElementById('kpi-calidad').innerText = avgCal.toFixed(1) + '%';
        }

        function renderCharts(data) {
