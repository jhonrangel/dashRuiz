                </div>
            </div>
        </div>
        
        <div class="flex items-center gap-4 w-full md:w-auto justify-end">
            <label for="excel-file-input" class="cursor-pointer bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-medium px-5 py-2.5 rounded-xl shadow-lg transition-all flex items-center gap-2 text-sm border border-blue-400/20">
