                        fill: true,
                        tension: 0.3,
                        pointRadius: 4,
                        pointBackgroundColor: 'rgba(99, 102, 241, 1)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#94a3b8' } } },
                    scales: {
                        x: { ticks: { color: '#94a3b8', font: { size: 10 } }, grid: { color: 'rgba(255,255,255,0.05)' } },
                        y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } }
                    }
                }
            });

            // Doughnut: Volumen por Proceso (Agrupado)
            const groupedVol = groupByProcess(data, 'vol');
            const ctxDonutVol = document.getElementById('doughnutVolumen').getContext('2d');
            doughnutVol = new Chart(ctxDonutVol, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(groupedVol),
                    datasets: [{
                        data: Object.values(groupedVol),
                        backgroundColor: ['#3b82f6', '#6366f1', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6', '#14b8a6', '#f43f5e']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'right', labels: { color: '#94a3b8', boxWidth: 12 } } }
                }
            });

            // Doughnut: Horas por Proceso (Agrupado)
            const groupedHrs = groupByProcess(data, 'horas');
            const ctxDonutHrs = document.getElementById('doughnutHoras').getContext('2d');
            doughnutHrs = new Chart(ctxDonutHrs, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(groupedHrs),
                    datasets: [{
                        data: Object.values(groupedHrs),
                        backgroundColor: ['#f59e0b', '#3b82f6', '#10b981', '#ec4899', '#6366f1', '#14b8a6', '#8b5cf6', '#f43f5e']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'right', labels: { color: '#94a3b8', boxWidth: 12 } } }
                }
            });
        }

        function updateCharts(data) {
            barChart.data.labels = data.map(d => d.subproceso);
            barChart.data.datasets[0].data = data.map(d => (d.rend * 100).toFixed(1));
            barChart.data.datasets[1].data = data.map(d => (d.oee * 100).toFixed(1));
            barChart.update();

            lineChart.data.labels = data.map(d => d.subproceso);
            lineChart.data.datasets[0].data = data.map(d => d.dif);
            lineChart.update();

            const groupedVol = groupByProcess(data, 'vol');
            doughnutVol.data.labels = Object.keys(groupedVol);
            doughnutVol.data.datasets[0].data = Object.values(groupedVol);
            doughnutVol.update();

            const groupedHrs = groupByProcess(data, 'horas');
            doughnutHrs.data.labels = Object.keys(groupedHrs);
            doughnutHrs.data.datasets[0].data = Object.values(groupedHrs);
            doughnutHrs.update();
        }

        function groupByProcess(data, key) {
            return data.reduce((acc, curr) => {
                acc[curr.proceso] = (acc[curr.proceso] || 0) + curr[key];
                return acc;
            }, {});
        }

        function renderTable(data) {
            const tbody = document.getElementById('data-table-body');
            tbody.innerHTML = data.map(row => `
                <tr class="hover:bg-slate-800/40 transition-colors">
                    <td class="p-4 font-medium text-white">${row.proceso}</td>
                    <td class="p-4 text-slate-300">${row.subproceso}</td>
                    <td class="p-4 text-right font-mono">${row.vol.toLocaleString()}</td>
                    <td class="p-4 text-right font-mono">${row.horas.toLocaleString()}</td>
                    <td class="p-4 text-right font-mono text-blue-400">${(row.efect * 100).toFixed(0)}%</td>
                    <td class="p-4 text-right font-mono">${(row.rend * 100).toFixed(0)}%</td>
                    <td class="p-4 text-right font-mono ${row.dif > 0 ? 'text-rose-400 font-semibold' : 'text-emerald-400'}">${row.dif}</td>
                    <td class="p-4 text-right font-mono">${(row.pCal * 100).toFixed(1)}%</td>
                    <td class="p-4 text-right font-mono font-semibold ${row.oee >= 1 ? 'text-emerald-400' : 'text-amber-400'}">${(row.oee * 100).toFixed(0)}%</td>
                </tr>
            `).join('');
        }

        function setupSearch() {
            document.getElementById('table-search').addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                const filtered = rawData.filter(item => 
                    item.subproceso.toLowerCase().includes(term) || item.proceso.toLowerCase().includes(term)
                );
                renderTable(filtered);
            });
        }

        // Excel file import listener
        document.getElementById('excel-file-input').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, {type: 'array'});
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                const json = XLSX.utils.sheet_to_json(worksheet, {header: 1});
                
                // Parse rows (ignoring header)
                if (json.length > 1) {
                    const parsedData = [];
                    for (let i = 1; i < json.length; i++) {
                        const row = json[i];
                        if (!row[0] || !row[1]) continue;
                        parsedData.push({
                            proceso: row[0],
                            subproceso: row[1],
                            prod: parseFloat(row[2]) || 0,
                            vol: parseFloat(row[3]) || 0,
                            horas: parseFloat(row[4]) || 0,
                            prod2: parseFloat(row[5]) || 0,
                            efect: parseNum(row[6]),
                            prodLm: parseFloat(row[7]) || 0,
                            rend: parseNum(row[8]),
                            hrsLm: parseFloat(row[9]) || 0,
                            dif: parseFloat(row[10]) || 0,
                            cal: parseFloat(row[11]) || 0,
                            pCal: parseNum(row[12]),
                            oee: parseNum(row[13])
                        });
                    }
                    if (parsedData.length > 0) {
                        rawData = parsedData;
                        currentFilter = 'ALL';
                        renderTabs();
                        updateKPIs(rawData);
                        updateCharts(rawData);
                        renderTable(rawData);
                        alert('¡Archivo Excel importado y dashboard actualizado con éxito!');
                    }
                }
            };
            reader.readAsArrayBuffer(file);
        });

        function parseNum(val) {
            if (typeof val === 'number') return val;
            if (!val) return 0;
            let clean = val.toString().replace('%', '').replace(',', '.');
            let num = parseFloat(clean);
            return clean.includes('%') || num > 1 ? num / 100 : num;
        }

        window.onload = initDashboard;
    </script>
</body>
</html>