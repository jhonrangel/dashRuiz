            <div class="mt-3 flex items-center text-xs text-slate-400"><span id="kpi-dif-horas" class="font-semibold mr-1">0</span> Dif Total de Horas</div>
        </div>

        <div class="glass-card p-5 rounded-2xl border-l-4 border-emerald-500 relative overflow-hidden">
